    <string>Vigil reads the address of your current browser tab to track time per website, and redirects blocked sites during focus sessions.</string>
    <key>NSAppSleepDisabled</key>
    <true/>
    <key>NSSupportsAutomaticTermination</key>
    <false/>
    <key>NSSupportsSuddenTermination</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Local-only activity tracker. Your data never leaves this Mac.</string>
