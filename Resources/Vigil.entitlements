<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime is on; this is the only exception: talking to browsers via Apple Events
         to read/redirect tabs. No network, JIT, unsigned memory or library-loading exceptions. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
